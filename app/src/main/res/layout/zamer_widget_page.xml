<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Ряд 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Карточка 1 -->
        <LinearLayout
            android:id="@+id/card_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <!-- Первая строка: время и микрофон -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/t1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF7043"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/t1_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎤"
                    android:textColor="#FFAB91"
                    android:textSize="16sp"
                    android:padding="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/t1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/t1_from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/t1_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Кнопки: звонок, карта, готово (без фона, крупнее) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/t1_call"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="✆"
                    android:textColor="#4CAF50"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/t1_map"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="⌖"
                    android:textColor="#1E88E5"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/t1_done"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="✔"
                    android:textColor="#81C784"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Карточка 2 (аналогично) -->
        <LinearLayout
            android:id="@+id/card_2"
            android:layout_width="0dp"
            android:layout_weight="1"
