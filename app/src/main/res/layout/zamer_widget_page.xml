                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/widget_btn_bg"
                    android:padding="8dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

