                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/t2_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎤"
                    android:textColor="#FFAB91"
                    android:textSize="16sp"
                    android:padding="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/t2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/t2_from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/t2_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/t2_call"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="✆"
                    android:textColor="#4CAF50"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/t2_map"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="⌖"
                    android:textColor="#1E88E5"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/t2_done"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="✔"
                    android:textColor="#81C784"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Ряд 2 (аналогично для карточек 3 и 4) -->
