<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="6dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📏 План замеров"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:padding="4dp" />

    <!-- Ряд 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Карточка 1 -->
        <LinearLayout
            android:id="@+id/card_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <TextView android:id="@+id/t1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF7043" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/t1_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/t1_addr" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <TextView android:id="@+id/t1_call" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📞" android:textColor="#FFAB91" android:textSize="12sp" />
                <TextView android:id="@+id/t1_map" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textColor="#90CAF9" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Карточка 2 -->
        <LinearLayout
            android:id="@+id/card_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <TextView android:id="@+id/t2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF7043" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/t2_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/t2_addr" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <TextView android:id="@+id/t2_call" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📞" android:textColor="#FFAB91" android:textSize="12sp" />
                <TextView android:id="@+id/t2_map" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textColor="#90CAF9" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Ряд 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Карточка 3 -->
        <LinearLayout
            android:id="@+id/card_3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <TextView android:id="@+id/t3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF7043" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/t3_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/t3_addr" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <TextView android:id="@+id/t3_call" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📞" android:textColor="#FFAB91" android:textSize="12sp" />
                <TextView android:id="@+id/t3_map" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textColor="#90CAF9" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Карточка 4 -->
        <LinearLayout
            android:id="@+id/card_4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <TextView android:id="@+id/t4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF7043" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/t4_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/t4_addr" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <TextView android:id="@+id/t4_call" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📞" android:textColor="#FFAB91" android:textSize="12sp" />
                <TextView android:id="@+id/t4_map" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textColor="#90CAF9" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Нет предстоящих замеров"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
