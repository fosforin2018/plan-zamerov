                    <ImageButton
                        android:id="@+id/t3_call"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_phone_widget"
                        android:background="@drawable/widget_call_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Позвонить"/>

                    <ImageButton
                        android:id="@+id/t3_map"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_location_widget"
                        android:background="@drawable/widget_map_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Карта"/>

                    <ImageButton
                        android:id="@+id/t3_done"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_check_widget"
                        android:background="@drawable/widget_done_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Готово"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================= CARD 4 ================= -->

            <LinearLayout
                android:id="@+id/card_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_card_bg"
                android:padding="10dp"
                android:layout_margin="2dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="62dp">

                    <TextView
                        android:id="@+id/t4_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:textColor="#FF4D1C"
                        android:textSize="23sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:id="@+id/t4_mic"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="9dp"
                        android:src="@drawable/ic_mic_widget"
                        android:background="@drawable/widget_mic_bg"
                        android:contentDescription="Голосовая заметка"/>

