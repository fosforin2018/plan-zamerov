                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#66FFFFFF"
                    android:text="" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp">

                    <ImageView
                        android:id="@+id/t2_call"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_phone_widget"
                        android:background="@drawable/widget_call_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Позвонить" />

                    <ImageView
                        android:id="@+id/t2_map"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_location_widget"
                        android:background="@drawable/widget_map_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Карта" />

                    <ImageView
                        android:id="@+id/t2_done"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_check_widget"
                        android:background="@drawable/widget_done_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Готово" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


