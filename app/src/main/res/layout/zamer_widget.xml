                        android:textSize="23sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:id="@+id/t2_mic"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="9dp"
                        android:src="@drawable/ic_mic_widget"
                        android:background="@drawable/widget_mic_bg"
                        android:contentDescription="Голосовая заметка"/>

                </RelativeLayout>


                <TextView
                    android:id="@+id/t2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp"/>


                <TextView
                    android:id="@+id/t2_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D0FFFFFF"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingBottom="5dp"/>


                <TextView
                    android:id="@+id/t2_addr"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:gravity="top"
                    android:paddingTop="2dp"
                    android:paddingBottom="7dp"/>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#66FFFFFF"/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingTop="7dp">

                    <ImageButton
                        android:id="@+id/t2_call"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_phone_widget"
                        android:background="@drawable/widget_call_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Позвонить"/>

                    <ImageButton
                        android:id="@+id/t2_map"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_location_widget"
                        android:background="@drawable/widget_map_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Карта"/>

                    <ImageButton
                        android:id="@+id/t2_done"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_check_widget"
                        android:background="@drawable/widget_done_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Готово"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


