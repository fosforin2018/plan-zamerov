                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp"/>

                <TextView
                    android:id="@+id/t4_from"
                    android:layout_width="match_parent"
