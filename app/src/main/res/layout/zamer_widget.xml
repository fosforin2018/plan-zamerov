<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/widget_tile_bg">

    <!-- ========================================================= -->
    <!-- HEADER                                                     -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="📏 План замеров"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end" />


    <!-- ========================================================= -->
    <!-- CARDS                                                      -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/cards_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">


        <!-- ===================================================== -->
        <!-- ROW 1                                                   -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">


            <!-- ================================================= -->
            <!-- CARD 1                                               -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/card_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:padding="9dp"
                android:orientation="vertical"
                android:background="@drawable/widget_card_bg">


                <!-- TIME + MICROPHONE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/t1_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#FF4D1C"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <ImageView
                        android:id="@+id/t1_mic"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_mic_widget"
                        android:background="@drawable/widget_mic_bg"
                        android:contentDescription="Голосовая заметка" />

                </LinearLayout>


                <!-- NAME -->

                <TextView
                    android:id="@+id/t1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp" />


                <!-- SOURCE -->

                <TextView
                    android:id="@+id/t1_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D0FFFFFF"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingBottom="4dp" />


                <!-- ADDRESS -->

                <TextView
                    android:id="@+id/t1_addr"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:gravity="top"
                    android:paddingTop="2dp"
                    android:paddingBottom="6dp" />


                <!-- DIVIDER -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#66FFFFFF"
                    android:text="" />


                <!-- BUTTONS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp">

                    <ImageView
                        android:id="@+id/t1_call"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_phone_widget"
                        android:background="@drawable/widget_call_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Позвонить" />

                    <ImageView
                        android:id="@+id/t1_map"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_location_widget"
                        android:background="@drawable/widget_map_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Карта" />

                    <ImageView
                        android:id="@+id/t1_done"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_check_widget"
                        android:background="@drawable/widget_done_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Готово" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CARD 2                                               -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/card_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
