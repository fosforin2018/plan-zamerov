                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_check_widget"
                        android:background="@drawable/widget_done_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Готово" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

