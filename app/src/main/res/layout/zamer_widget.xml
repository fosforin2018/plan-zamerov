    <!-- ========================================================= -->
    <!-- PAGINATION                                                  -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/btn_prev"
            android:layout_width="58dp"
            android:layout_height="54dp"
            android:text="‹"
            android:textColor="#FF7A35"
            android:textSize="42sp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:background="@drawable/widget_nav_button" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:background="@drawable/widget_dot_active"
                android:text="" />

            <TextView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:background="@drawable/widget_dot"
                android:text="" />

            <TextView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:background="@drawable/widget_dot"
                android:text="" />

            <TextView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:background="@drawable/widget_dot"
                android:text="" />

        </LinearLayout>


        <TextView
            android:id="@+id/btn_next"
            android:layout_width="58dp"
            android:layout_height="54dp"
            android:text="›"
            android:textColor="#FF7A35"
            android:textSize="42sp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:background="@drawable/widget_nav_button" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- EMPTY                                                      -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Нет предстоящих замеров"
        android:textColor="#CCFFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>
