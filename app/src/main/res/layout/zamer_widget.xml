<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="7dp"
    android:background="@drawable/widget_tile_bg">

    <!-- ==================== HEADER ==================== -->

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="📏 План замеров · 2"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- ==================== CARDS ==================== -->

    <LinearLayout
        android:id="@+id/cards_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ==================== ROW 1 ==================== -->

        <LinearLayout
            android:id="@+id/cards_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ================= CARD 1 ================= -->

            <LinearLayout
                android:id="@+id/card_1"
                android:layout_width="0dp"
                android:layout_height="174dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_card_bg"
                android:padding="8dp"
                android:layout_margin="2dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp">

                    <TextView
                        android:id="@+id/t1_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:textColor="#FF4D1C"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:maxLines="1" />

                    <ImageView
                        android:id="@+id/t1_mic"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_mic_widget"
                        android:background="@drawable/widget_mic_bg"
                        android:contentDescription="Голосовая заметка" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/t1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingTop="1dp"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/t1_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D0FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/t1_addr"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="top"
                    android:paddingTop="1dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#66FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingTop="4dp">

                    <ImageButton
                        android:id="@+id/t1_call"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_phone_widget"
                        android:background="@drawable/widget_call_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Позвонить" />

                    <ImageButton
                        android:id="@+id/t1_map"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_location_widget"
                        android:background="@drawable/widget_map_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Карта" />

                    <ImageButton
                        android:id="@+id/t1_done"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_check_widget"
                        android:background="@drawable/widget_done_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Готово" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================= CARD 2 ================= -->

